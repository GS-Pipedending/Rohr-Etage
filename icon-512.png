<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>PWA Icon - Präzise Geometrie (Mit neutraler Faser)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 min-h-screen flex flex-col items-center justify-center p-4 text-white">

  <div class="space-y-6 text-center">
    <h1 class="text-xl font-bold">App-Icon Geometrie (Optimierte Rohrdarstellung)</h1>
    <p class="text-sm text-slate-400">Ohne inneren Kanalstrich, mit roter gestrichelter neutraler Faser.</p>

    <!-- Vorschau des Icons -->
    <div class="flex justify-center">
      <svg id="icon_svg" viewBox="0 0 1024 1024" class="w-64 h-64 shadow-2xl rounded-3xl">
        
        <!-- EBENE 1: Der 80% Hintergrundrahmen -->
        <g id="layer_background">
          <rect x="102" y="102" width="820" height="820" rx="180" fill="#4f46e5" stroke="#312e81" stroke-width="16" />
        </g>

        <!-- EBENE 2: Das Rohr (Mit Außenkontur, innerem Körper, roter Mittellinie und geraden Enden) -->
        <g id="layer_pipe">
          <!-- Äußere Rohrkontur (Dunkler Rand) -->
          <path d="M 262 850 L 262 512 A 250 250 0 0 1 512 262 L 800 262" 
                fill="none" stroke="#0f172a" stroke-width="144" stroke-linecap="butt" stroke-linejoin="round" />
          
          <!-- Innerer Rohrkörper (Technisches Hellgrau) -->
          <path d="M 262 850 L 262 512 A 250 250 0 0 1 512 262 L 800 262" 
                fill="none" stroke="#f8fafc" stroke-width="96" stroke-linecap="butt" stroke-linejoin="round" />
          
          <!-- Neutrale Faser / Mittellinie (Rot, gestrichelt) -->
          <path d="M 262 850 L 262 512 A 250 250 0 0 1 512 262 L 800 262" 
                fill="none" stroke="#ef4444" stroke-width="6" stroke-dasharray="16,12" stroke-linecap="butt" stroke-linejoin="round" />

          <!-- Saubere Wandungs-Abschlüsse an den Rohrenden -->
          <!-- Unteres Rohrende Abschluss -->
          <line x1="190" y1="850" x2="334" y2="850" stroke="#0f172a" stroke-width="12" stroke-linecap="square" />
          <line x1="214" y1="850" x2="310" y2="850" stroke="#f8fafc" stroke-width="6" />

          <!-- Rechtes Rohrende Abschluss -->
          <line x1="800" y1="190" x2="800" y2="334" stroke="#0f172a" stroke-width="12" stroke-linecap="square" />
          <line x1="800" y1="214" x2="800" y2="310" stroke="#f8fafc" stroke-width="6" />
        </g>

        <!-- EBENE 3: Die Biegerolle (Zentrum X=512, Y=512, Ø 500 -> Radius 250) -->
        <g id="layer_bending_roll">
          <!-- Äußerer Kreis der Rolle -->
          <circle cx="512" cy="512" r="250" fill="#cbd5e1" stroke="#0f172a" stroke-width="16" />
          
          <!-- Die Nut / Ausrundung -->
          <circle cx="512" cy="512" r="214" fill="none" stroke="#94a3b8" stroke-width="8" stroke-dasharray="12,12" />

          <!-- Inneres Loch (Bohrung Ø 150 -> Radius 75) -->
          <circle cx="512" cy="512" r="75" fill="#4f46e5" stroke="#0f172a" stroke-width="16" />
        </g>

      </svg>
    </div>

    <div>
      <button onclick="downloadIcon()" class="bg-indigo-600 hover:bg-indigo-500 font-bold px-6 py-3 rounded-xl shadow-lg transition-all">
        Geometrie als PNG herunterladen (1024x1024)
      </button>
    </div>
  </div>

  <script>
    function downloadIcon() {
      const svgElement = document.getElementById('icon_svg');
      const svgString = new XMLSerializer().serializeToString(svgElement);
      const svgBlob = new Blob([svgString], { type: 'image/svg+xml;charset=utf-8' });
      const URL = window.URL || window.webkitURL || URL;
      const blobURL = URL.createObjectURL(svgBlob);

      const image = new Image();
      image.onload = function() {
        const canvas = document.createElement('canvas');
        canvas.width = 1024;
        canvas.height = 1024;
        const context = canvas.getContext('2d');
        context.drawImage(image, 0, 0, 1024, 1024);

        const png = canvas.toDataURL('image/png');
        const downloadLink = document.createElement('a');
        downloadLink.href = png;
        downloadLink.download = 'icon-geometrie-perfekt.png';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
      };
      image.src = blobURL;
    }
  </script>
</body>
</html>